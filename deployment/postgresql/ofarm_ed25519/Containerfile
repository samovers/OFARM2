# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH=0

FROM --platform=$TARGETPLATFORM postgres@sha256:5f050f770b427fbd477edee6c3968a72e5c6be97e050a7e368b2b74a9494a285 AS postgres-runtime

FROM --platform=$TARGETPLATFORM gcc@sha256:1ea81e094f614fd2ed066316651dbac8eecb4d36add2ddd8a26151374c85c52c AS server-dev-amd64
ADD --checksum=sha256:adc91a999ec840f8db8c8df5ac2473fe1deeaed0e76bd5a6391afa7c74bceac3 \
    https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-17/postgresql-server-dev-17_17.10-1.pgdg13+1_amd64.deb \
    /tmp/postgresql-server-dev-17.deb
RUN --network=none \
    test "$(stat --format='%s' /tmp/postgresql-server-dev-17.deb)" = '1338208' \
 && printf '%s  %s\n' \
      'adc91a999ec840f8db8c8df5ac2473fe1deeaed0e76bd5a6391afa7c74bceac3' \
      /tmp/postgresql-server-dev-17.deb \
      | sha256sum --check --strict

FROM --platform=$TARGETPLATFORM gcc@sha256:1ea81e094f614fd2ed066316651dbac8eecb4d36add2ddd8a26151374c85c52c AS server-dev-arm64
ADD --checksum=sha256:372c8eb77604bc9cba61689661701e65a336b14a43e8f9be850088bb8c4428b6 \
    https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-17/postgresql-server-dev-17_17.10-1.pgdg13+1_arm64.deb \
    /tmp/postgresql-server-dev-17.deb
RUN --network=none \
    test "$(stat --format='%s' /tmp/postgresql-server-dev-17.deb)" = '1327764' \
 && printf '%s  %s\n' \
      '372c8eb77604bc9cba61689661701e65a336b14a43e8f9be850088bb8c4428b6' \
      /tmp/postgresql-server-dev-17.deb \
      | sha256sum --check --strict

FROM server-dev-${TARGETARCH} AS build-inputs
ARG TARGETARCH
ARG SOURCE_DATE_EPOCH
ENV LC_ALL=C \
    TZ=UTC \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    ZERO_AR_DATE=1

COPY --from=postgres-runtime \
    /usr/lib/postgresql/17/bin/pg_config \
    /usr/lib/postgresql/17/bin/pg_config
COPY --from=postgres-runtime \
    /usr/lib/postgresql/17/lib/pgxs \
    /usr/lib/postgresql/17/lib/pgxs

RUN --network=none \
    test "$(dpkg-deb --field /tmp/postgresql-server-dev-17.deb Package)" = \
         'postgresql-server-dev-17' \
 && test "$(dpkg-deb --field /tmp/postgresql-server-dev-17.deb Version)" = \
         '17.10-1.pgdg13+1' \
 && test "$(dpkg-deb --field /tmp/postgresql-server-dev-17.deb Architecture)" = \
         "${TARGETARCH}" \
 && dpkg-deb --extract /tmp/postgresql-server-dev-17.deb / \
 && rm /tmp/postgresql-server-dev-17.deb \
 && test "$(/usr/lib/postgresql/17/bin/pg_config --version)" = \
         'PostgreSQL 17.10 (Debian 17.10-1.pgdg13+1)' \
 && test "$(/usr/lib/postgresql/17/bin/pg_config --pgxs)" = \
         '/usr/lib/postgresql/17/lib/pgxs/src/makefiles/pgxs.mk' \
 && test -f /usr/lib/postgresql/17/lib/pgxs/src/makefiles/pgxs.mk \
 && test -f /usr/include/postgresql/17/server/postgres.h

WORKDIR /build
ADD --checksum=sha256:adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349 \
    https://download.libsodium.org/libsodium/releases/libsodium-1.0.22.tar.gz \
    /build/libsodium.tar.gz
RUN --network=none \
    test "$(stat --format='%s' /build/libsodium.tar.gz)" = '2008529' \
 && printf '%s  %s\n' \
      'adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349' \
      /build/libsodium.tar.gz \
      | sha256sum --check --strict \
 && mkdir /build/libsodium \
 && tar --extract --gzip --file /build/libsodium.tar.gz \
      --directory /build/libsodium --strip-components=1

WORKDIR /build/ofarm_ed25519
COPY Makefile \
     ofarm_ed25519--1.0.sql \
     ofarm_ed25519.c \
     ofarm_ed25519.control \
     ofarm_ed25519.exports \
     ofarm_ed25519_core.c \
     ofarm_ed25519_core.h \
     ofarm_ed25519_fuzz.c \
     ofarm_ed25519_harness.c \
     ofarm_ed25519_vectors.h \
     ofarm_ed25519_vectors.json \
     ofarm_ed25519_vectors.sha256 \
     ofarm_ed25519_vectors.sql \
     ./

FROM build-inputs AS extension-build
RUN --network=none \
    cd /build/libsodium \
 && CFLAGS='-O2 -fPIC -fvisibility=hidden -fno-plt -fstack-protector-strong -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=.' \
      ./configure \
        --prefix=/opt/ofarm-libsodium \
        --disable-shared \
        --enable-static \
 && make -j1 \
 && make -j1 check \
 && make -j1 install \
 && find /opt/ofarm-libsodium -exec touch --date='@0' {} +

WORKDIR /build/ofarm_ed25519
RUN --network=none \
    test "$(wc --lines < ofarm_ed25519_vectors.sha256)" = '1' \
 && sha256sum --check --strict ofarm_ed25519_vectors.sha256 \
 && VECTOR_DIGEST="$(cut --delimiter=' ' --fields=1 \
      ofarm_ed25519_vectors.sha256)" \
 && grep --fixed-strings "sha256:${VECTOR_DIGEST}" ofarm_ed25519_vectors.h \
 && grep --fixed-strings "sha256:${VECTOR_DIGEST}" ofarm_ed25519_vectors.sql \
 && cc \
      -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
      -fstack-protector-strong \
      -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=. \
      -I/opt/ofarm-libsodium/include \
      ofarm_ed25519_core.c ofarm_ed25519_harness.c \
      /opt/ofarm-libsodium/lib/libsodium.a \
      -o /build/ofarm_ed25519_harness \
 && /build/ofarm_ed25519_harness \
 && cc \
      -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
      -fstack-protector-strong \
      -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=. \
      -I/opt/ofarm-libsodium/include \
      ofarm_ed25519_core.c ofarm_ed25519_fuzz.c \
      /opt/ofarm-libsodium/lib/libsodium.a \
      -o /build/ofarm_ed25519_fuzz \
 && /build/ofarm_ed25519_fuzz \
 && make clean \
 && make -j1 \
      PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
      PG_CFLAGS='-Wextra -Werror -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=.' \
      with_llvm=no \
 && make -j1 \
      PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
      with_llvm=no \
      install \
 && test "$(nm -D --defined-only /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      | awk '{print $3}' | LC_ALL=C sort | tr '\n' ' ')" = \
      'Pg_magic_func _PG_init ofarm_ed25519_verify pg_finfo_ofarm_ed25519_verify ' \
 && ! readelf --dynamic /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      | grep --fixed-strings 'libsodium' \
 && ! readelf --dynamic /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      | grep --extended-regexp 'lib(asan|ubsan)' \
 && ! nm -D /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      | grep --extended-regexp ' (crypto_|randombytes_|sodium_)' \
 && ! strings /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      | grep --fixed-strings 'OFARM test-only' \
 && touch --date='@0' \
      /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      /usr/share/postgresql/17/extension/ofarm_ed25519.control \
      /usr/share/postgresql/17/extension/ofarm_ed25519--1.0.sql \
 && install --directory \
      /opt/ofarm-final-root/usr/lib/postgresql/17/lib \
      /opt/ofarm-final-root/usr/share/postgresql/17/extension \
 && install --mode=0755 \
      /usr/lib/postgresql/17/lib/ofarm_ed25519.so \
      /opt/ofarm-final-root/usr/lib/postgresql/17/lib/ofarm_ed25519.so \
 && install --mode=0644 \
      /usr/share/postgresql/17/extension/ofarm_ed25519.control \
      /usr/share/postgresql/17/extension/ofarm_ed25519--1.0.sql \
      /opt/ofarm-final-root/usr/share/postgresql/17/extension/ \
 && find /opt/ofarm-final-root -exec touch --date='@0' {} +

FROM extension-build AS failure-semantics-build
RUN --network=none \
    set -eu; \
    install --directory /opt/ofarm-test-only \
 && build_fault() { \
      output="$1"; \
      fault_macro="$2"; \
      make clean; \
      make -j1 \
        PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
        SODIUM_PREFIX=/opt/ofarm-libsodium \
        OFARM_TEST_CPPFLAGS="-DOFARM_ED25519_TEST_BUILD -D${fault_macro}" \
        OFARM_EXTRA_CFLAGS='-Wextra -Werror' \
        with_llvm=no; \
      install --mode=0755 \
        ofarm_ed25519.so "/opt/ofarm-test-only/${output}.so"; \
    }; \
    build_fault ofarm_ed25519_fault_sodium \
      OFARM_ED25519_TEST_FAULT_SODIUM_INIT \
 && build_fault ofarm_ed25519_fault_unexpected \
      OFARM_ED25519_TEST_FAULT_UNEXPECTED_VERIFY_RESULT \
 && build_fault ofarm_ed25519_fault_oom \
      OFARM_ED25519_TEST_FAULT_DETOAST_OOM \
 && build_fault ofarm_ed25519_fault_cancel \
      OFARM_ED25519_TEST_FAULT_DETOAST_CANCEL \
 && build_fault ofarm_ed25519_fault_timeout \
      OFARM_ED25519_TEST_FAULT_DETOAST_TIMEOUT \
 && build_fault ofarm_ed25519_fault_transaction \
      OFARM_ED25519_TEST_FAULT_DETOAST_TRANSACTION \
 && build_fault ofarm_ed25519_fault_storage \
      OFARM_ED25519_TEST_FAULT_DETOAST_STORAGE \
 && test "$(find /opt/ofarm-test-only -type f -name '*.so' | wc -l)" = '7' \
 && for object in /opt/ofarm-test-only/*.so; do \
      test "$(nm -D --defined-only "${object}" \
        | awk '{print $3}' | LC_ALL=C sort | tr '\n' ' ')" = \
        'Pg_magic_func _PG_init ofarm_ed25519_verify pg_finfo_ofarm_ed25519_verify '; \
    done

FROM postgres-runtime AS failure-semantics
COPY --from=failure-semantics-build /opt/ofarm-test-only/ /opt/ofarm-test-only/
COPY ofarm_ed25519_fault_test.sql /tmp/ofarm_ed25519_fault_test.sql
RUN --network=none chown postgres:postgres /tmp/ofarm_ed25519_fault_test.sql
USER postgres
RUN --network=none \
    initdb --no-sync --auth=trust --pgdata=/tmp/ofarm-ed25519-fault-data \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-fault-data \
      --options="-c listen_addresses='' -c unix_socket_directories=/tmp" \
      --wait start \
 && psql --host=/tmp --dbname=postgres \
      --file=/tmp/ofarm_ed25519_fault_test.sql \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-fault-data \
      --mode=immediate --wait stop

FROM scratch AS evidence-artifacts
COPY --from=extension-build \
    /opt/ofarm-libsodium/lib/libsodium.a \
    /libsodium.a
COPY --from=extension-build \
    /opt/ofarm-final-root/usr/lib/postgresql/17/lib/ofarm_ed25519.so \
    /ofarm_ed25519.so
COPY --from=extension-build \
    /opt/ofarm-final-root/usr/share/postgresql/17/extension/ofarm_ed25519.control \
    /ofarm_ed25519.control
COPY --from=extension-build \
    /opt/ofarm-final-root/usr/share/postgresql/17/extension/ofarm_ed25519--1.0.sql \
    /ofarm_ed25519--1.0.sql

FROM postgres-runtime AS live-test
COPY --from=extension-build /opt/ofarm-final-root/ /
COPY --from=extension-build /opt/ofarm-final-root/ /opt/ofarm-final-root/
COPY ofarm_ed25519_live_test.sql /tmp/ofarm_ed25519_live_test.sql
COPY ofarm_ed25519_vectors.sql /tmp/ofarm_ed25519_vectors.sql
RUN --network=none \
    chown postgres:postgres \
      /tmp/ofarm_ed25519_live_test.sql \
      /tmp/ofarm_ed25519_vectors.sql
USER postgres
RUN --network=none \
    initdb --no-sync --auth=trust --pgdata=/tmp/ofarm-ed25519-test-data \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-test-data \
      --options="-c listen_addresses='' -c unix_socket_directories=/tmp" \
      --wait start \
 && psql --host=/tmp --dbname=postgres \
      --file=/tmp/ofarm_ed25519_live_test.sql \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-test-data \
      --mode=immediate --wait stop

FROM build-inputs AS sanitizer-build
ARG SANITIZER
ARG TARGETARCH
RUN --network=none \
    set -eu; \
    case "${SANITIZER}" in \
      address|undefined) ;; \
      *) echo 'SANITIZER must be exactly address or undefined' >&2; exit 64 ;; \
    esac \
 && case "${TARGETARCH}" in \
      arm64) SANITIZER_ARCH_FLAGS='-mgeneral-regs-only' ;; \
      amd64) SANITIZER_ARCH_FLAGS='' ;; \
      *) echo 'TARGETARCH must be exactly amd64 or arm64' >&2; exit 64 ;; \
    esac \
 && SANITIZER_FLAGS="-O1 -g -fno-omit-frame-pointer -fno-sanitize-recover=all -fsanitize=${SANITIZER} -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=. ${SANITIZER_ARCH_FLAGS}" \
 && cd /build/libsodium \
 && CFLAGS="${SANITIZER_FLAGS} -fPIC -fvisibility=hidden" \
      LDFLAGS="${SANITIZER_FLAGS}" \
      ./configure \
        --prefix=/opt/ofarm-libsodium-sanitized \
        --disable-asm \
        --disable-pie \
        --disable-shared \
        --enable-pic \
        --enable-static \
 && make -j1 \
 && ASAN_OPTIONS='abort_on_error=1:detect_leaks=1:halt_on_error=1:strict_string_checks=1' \
      UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1' \
      make -j1 check \
      || { find /build/libsodium -name test-suite.log -type f \
             -exec sh -c 'for log do echo "===== ${log}"; cat "${log}"; done' sh {} +; \
           exit 1; } \
 && make -j1 install \
 && cd /build/ofarm_ed25519 \
 && cc \
      -std=c11 -Wall -Wextra -Werror -Wpedantic \
      ${SANITIZER_FLAGS} \
      -I/opt/ofarm-libsodium-sanitized/include \
      ofarm_ed25519_core.c ofarm_ed25519_harness.c \
      /opt/ofarm-libsodium-sanitized/lib/libsodium.a \
      -o /build/ofarm_ed25519_harness_sanitized \
 && cc \
      -std=c11 -Wall -Wextra -Werror -Wpedantic \
      ${SANITIZER_FLAGS} \
      -I/opt/ofarm-libsodium-sanitized/include \
      ofarm_ed25519_core.c ofarm_ed25519_fuzz.c \
      /opt/ofarm-libsodium-sanitized/lib/libsodium.a \
      -o /build/ofarm_ed25519_fuzz_sanitized \
 && ASAN_OPTIONS='abort_on_error=1:detect_leaks=1:halt_on_error=1:strict_string_checks=1' \
      UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1' \
      /build/ofarm_ed25519_harness_sanitized \
 && ASAN_OPTIONS='abort_on_error=1:detect_leaks=1:halt_on_error=1:strict_string_checks=1' \
      UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1' \
      /build/ofarm_ed25519_fuzz_sanitized \
 && make clean \
 && make -j1 \
      PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
      SODIUM_PREFIX=/opt/ofarm-libsodium-sanitized \
      OFARM_EXTRA_CFLAGS="-Wextra -Werror ${SANITIZER_FLAGS}" \
      OFARM_EXTRA_LDFLAGS="${SANITIZER_FLAGS}" \
      with_llvm=no \
 && install --directory \
      /opt/ofarm-sanitized-root/usr/lib/postgresql/17/lib \
      /opt/ofarm-sanitized-root/usr/share/postgresql/17/extension \
      /opt/ofarm-sanitizer/lib \
 && install --mode=0755 \
      ofarm_ed25519.so \
      /opt/ofarm-sanitized-root/usr/lib/postgresql/17/lib/ofarm_ed25519.so \
 && install --mode=0644 \
      ofarm_ed25519.control ofarm_ed25519--1.0.sql \
      /opt/ofarm-sanitized-root/usr/share/postgresql/17/extension/ \
 && copy_runtime() { \
      requested="$1"; \
      source_path="$(cc -print-file-name="${requested}")"; \
      soname="$(objdump --private-headers "${source_path}" \
        | awk '$1 == "SONAME" {print $2}')"; \
      test -n "${soname}"; \
      cp --dereference \
        "${source_path}" "/opt/ofarm-sanitizer/lib/${soname}"; \
      chmod 0755 "/opt/ofarm-sanitizer/lib/${soname}"; \
      ln --symbolic "${soname}" "/opt/ofarm-sanitizer/lib/${requested}"; \
    } \
 && case "${SANITIZER}" in \
      address) copy_runtime libasan.so ;; \
      undefined) \
        copy_runtime libubsan.so; \
        copy_runtime libstdc++.so; \
        ;; \
    esac

FROM postgres-runtime AS sanitizer
ARG SANITIZER
ENV LD_LIBRARY_PATH=/opt/ofarm-sanitizer/lib
COPY --from=sanitizer-build /opt/ofarm-sanitized-root/ /
COPY --from=sanitizer-build /opt/ofarm-sanitizer/ /opt/ofarm-sanitizer/
COPY ofarm_ed25519_live_test.sql /tmp/ofarm_ed25519_live_test.sql
COPY ofarm_ed25519_vectors.sql /tmp/ofarm_ed25519_vectors.sql
RUN --network=none \
    chown postgres:postgres \
      /tmp/ofarm_ed25519_live_test.sql \
      /tmp/ofarm_ed25519_vectors.sql
USER postgres
RUN --network=none \
    set -eu; \
    case "${SANITIZER}" in \
      address) \
        export LD_PRELOAD=/opt/ofarm-sanitizer/lib/libasan.so; \
        export ASAN_OPTIONS='abort_on_error=1:detect_leaks=0:halt_on_error=1:strict_string_checks=1' \
        ;; \
      undefined) \
        export UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1' \
        ;; \
      *) echo 'SANITIZER must be exactly address or undefined' >&2; exit 64 ;; \
    esac \
 && initdb --no-sync --auth=trust --pgdata=/tmp/ofarm-ed25519-sanitizer-data \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-sanitizer-data \
      --options="-c listen_addresses='' -c unix_socket_directories=/tmp" \
      --wait start \
 && psql --host=/tmp --dbname=postgres \
      --file=/tmp/ofarm_ed25519_live_test.sql \
 && pg_ctl --pgdata=/tmp/ofarm-ed25519-sanitizer-data \
      --mode=immediate --wait stop

FROM --platform=$TARGETPLATFORM postgres@sha256:5f050f770b427fbd477edee6c3968a72e5c6be97e050a7e368b2b74a9494a285
COPY --from=live-test /opt/ofarm-final-root/ /
